# Solana Indexer Configuration
# Copy this file to .env and configure the variables for your environment

# RPC_URL (Required)
# The Solana RPC endpoint URL to connect to for fetching blockchain data
# Examples:
#   - Mainnet: https://api.mainnet-beta.solana.com
#   - Devnet: https://api.devnet.solana.com
#   - Testnet: https://api.testnet.solana.com
#   - Custom RPC: https://your-rpc-provider.com
RPC_URL=https://api.devnet.solana.com

# DATABASE_URL (Required)
# PostgreSQL connection string in the format:
# postgresql://username:password@host:port/database_name
# Make sure the database exists and is accessible
DATABASE_URL=postgresql://username:password@localhost:5432/solana_indexer

# START_SLOT (Optional)
# The slot number to start indexing from
# If not specified, the indexer will:
#   - Resume from the last indexed slot if available in the database
#   - Otherwise start from the current slot
# Example: START_SLOT=123456789
START_SLOT=

# COMMITMENT (Optional, default: finalized)
# The commitment level for fetching data from the RPC node
# Valid values:
#   - finalized: Maximum security, data is confirmed by supermajority
#   - confirmed: High security, confirmed by cluster
#   - processed: Low security, optimistic confirmation
# Default: finalized
COMMITMENT=finalized

# API Configuration (for future REST API support)
# These will be used when the REST API feature is implemented
# API_BIND_ADDRESS=0.0.0.0
# API_PORT=3000